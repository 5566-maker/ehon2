# 复制为 .env 后填入真实值。此文件绝不提交到 git。
# .env 文件权限建议设为 600，仅放在部署机器上。
# 变量名必须与 apps/server/src/env.ts 保持一致。

# ---------- 必填 ----------
# OpenAI API Key（服务端直连 OpenAI，不经过前端）
OPENAI_API_KEY=

# 登录用户名（单用户）
AUTH_USERNAME=
# 登录密码的哈希，用 scripts/hash-password.mjs 生成后填入
AUTH_PASSWORD_HASH=

# 会话签名密钥：随机 32 字节以上 hex
SESSION_SECRET=

# ---------- 可选（括号内为默认值） ----------
# PORT=3000
# DATA_DIR=/data
# APP_NAME=Yomikiki Books
# APP_BASE_URL=
# SESSION_COOKIE_NAME=ehon2_session
# SESSION_TTL_HOURS=720

# OPENAI_VISION_MODEL=gpt-5.6-luna
# OPENAI_ENRICHMENT_FALLBACK=gpt-5.6-sol
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# DEFAULT_JA_VOICE=alloy
# DEFAULT_ZH_VOICE=echo
# DEFAULT_EN_VOICE=verse

# ---------- 内页 OCR：Google Vision ----------
# 内页识别由 Google Vision 做 OCR（文字 + 精确坐标），OpenAI 只做文本
# enrichment（分组/翻译/注音/讲解），不再生成坐标。
# 以下两个变量任选其一即可；两个都不设时默认走 Google。
# OCR_PROVIDER=google
# GOOGLE_VISION_ENABLED=true

# Google Vision API Key（服务端直连 googleapis，不经过前端）
# 缺失时服务照常启动，但内页识别会明确报错；
# 在 Zeabur 的环境变量里设置即可。
# GOOGLE_VISION_API_KEY=<redacted>

# 兼容旧链路（OpenAI 直接做 OCR + bbox）：OCR_PROVIDER=openai-legacy

# IMAGE_MAX_DIM=1600
# IMAGE_QUALITY=80
# UPLOAD_MAX_MB=15
# UPLOAD_MAX_FILES=30

# AUDIO_MAX_CHARS=4000

# 调试/覆盖（一般不需要）
# PUBLIC_DIR=
# MIGRATIONS_DIR=
# COOKIE_SECURE=true

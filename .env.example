# 复制为 .env 后填入真实值。此文件绝不提交到 git。
# .env 文件权限建议设为 600，仅放在部署机器上。

# ---------- 必填 ----------
# OpenAI API Key（服务端直连 OpenAI，不经过前端）
OPENAI_API_KEY=

# 登录用户名（单用户）
AUTH_USERNAME=
# 登录密码的哈希，用 scripts/hash-password.mjs 生成后填入
AUTH_PASSWORD_HASH=

# 会话签名密钥：随机 32 字节以上 hex
SESSION_SECRET=

# ---------- 可选（括号内为默认值） ----------
# PORT=3000
# DATA_DIR=/data
# SESSION_COOKIE_NAME=ehon2_session
# SESSION_TTL_HOURS=720

# OPENAI_VISION_MODEL=gpt-4o
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE_JA=alloy
# OPENAI_TTS_VOICE_ZH=echo
# OPENAI_TTS_VOICE_EN=verse

# IMAGE_MAX_DIM=1600
# AUDIO_MAX_CHARS=4000

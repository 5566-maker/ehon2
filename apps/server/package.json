{
  "dependencies": {
    "@ehon2/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "openai": "^5.0.0",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "name": "@ehon2/server",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @ehon2/shared build && tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretypecheck": "pnpm --filter @ehon2/shared build",
    "test": "tsx --test src/auth/password.test.ts src/validation.test.ts src/storage/keys.test.ts src/openai/ai.test.ts src/ocr/ocr.test.ts src/db/db.test.ts src/tts/providers.test.ts src/routes/pages.test.ts src/routes/books.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
